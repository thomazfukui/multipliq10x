# Copie para .env e preencha. O .env NÃO vai para o git.

# Certificado digital A1 (e-CNPJ) exportado do navegador como .pfx
NFSE_CERT_PFX=/caminho/para/certificado.pfx
NFSE_CERT_SENHA=

# Gmail: use uma "senha de app" (https://myaccount.google.com/apppasswords),
# não a senha normal da conta. Exige verificação em duas etapas ativa.
GMAIL_USUARIO=seuemail@gmail.com
GMAIL_SENHA_APP=

# Chave da API da Anthropic (https://console.anthropic.com) — usada para ler o relatório em PDF
ANTHROPIC_API_KEY=
